{
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "bugs": {
    "url": "https://github.com/piro0919/react-comic-viewer/issues"
  },
  "dependencies": {
    "react-icons": "^5.7.0",
    "react-swipeable": "^7.0.2",
    "screenfull": "^6.0.2"
  },
  "description": "Comic viewer and manga viewer component for React",
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/analytics": "2.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "esbuild-css-modules-plugin": "^3.1.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "funding": "https://github.com/sponsors/piro0919",
  "homepage": "https://react-comic-viewer.kkweb.io",
  "keywords": [
    "comic",
    "comic viewer",
    "comic reader",
    "manga",
    "manga viewer",
    "manga reader",
    "react",
    "viewer",
    "image-viewer",
    "book-reader",
    "rtl",
    "ltr",
    "fullscreen",
    "swipe",
    "touch",
    "zoom",
    "thumbnails",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "name": "react-comic-viewer",
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/piro0919/react-comic-viewer.git"
  },
  "scripts": {
    "build": "next build",
    "build:lib": "node scripts/build.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly --rootDir src/lib --declarationDir dist",
    "dev": "next dev",
    "format": "biome format --write",
    "lint": "biome check",
    "prepublishOnly": "pnpm run test && pnpm run build:lib",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": [
    "*.css"
  ],
  "types": "dist/index.d.ts",
  "version": "1.1.3"
}
